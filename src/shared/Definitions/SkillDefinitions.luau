local function deepFreeze(value: any): any
	if type(value) == "table" and not table.isfrozen(value) then
		for _, child in value do
			deepFreeze(child)
		end
		table.freeze(value)
	end
	return value
end

-- Level needed for `tier` in branch column `column` (1-based).
function SkillDefinitions.unlockLevelFor(tier: number, column: number): number
	local base = SkillDefinitions.TIER_LEVELS[tier] or 0
	return if tier <= 1 then base else base + (column - 1)
end

local byId: { [string]: Skill } = {}
local byJob: { [string]: { Skill } } = {}
local ids: { string } = {}
local byCell: { [string]: Skill } = {}
for _, skill in skills :: { any } do
	byCell[`{skill.job}.{skill.branch}.{skill.tier}`] = skill
end
for _, skill in skills :: { any } do
	local column = 1
	for index, branch in (SkillDefinitions.Branches :: any)[skill.job] or {} do
		if branch.id == skill.branch then
			column = index
		end
	end
	local mutable = skill :: any
	mutable.unlockLevel = SkillDefinitions.unlockLevelFor(skill.tier, column)
	mutable.maxRank = if skill.type == "Special"
		then SkillDefinitions.SPECIAL_MAX_RANK
		else SkillDefinitions.REGULAR_MAX_RANK
	local above = byCell[`{skill.job}.{skill.branch}.{skill.tier - 1}`]
	mutable.requires = if above then above.id else nil
	byId[skill.id] = skill
	byJob[skill.job] = byJob[skill.job] or {}
	table.insert(byJob[skill.job], skill)
	table.insert(ids, skill.id)
end

-- Basic skills (not in any tree column, not in All): every class has them.
-- The id stays "AutoAttack" (saved skill bars hold it); the skill is shown
-- as "Attack" since the hands-free Auto-attack toggle arrived (creator
-- review 2026-10-24, CombatController).
SkillDefinitions.AUTO_ATTACK = "AutoAttack"
local basics: { any } = {
	{
		id = SkillDefinitions.AUTO_ATTACK,
		name = "Attack",
		job = "Any",
		branch = "Basic",
		tier = 0,
		type = "Regular",
		category = "Basic",
		description = "Attacks your target (or the nearest creature) with your normal attack combo, walking into reach first, and keeps attacking until it falls. Moving stops it.",
		icon = "strike",
