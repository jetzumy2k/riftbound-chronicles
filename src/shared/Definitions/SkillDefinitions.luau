		range = 0,
		cooldown = 0,
		focusCost = 0,
		effects = {},
		fx = fx("Steel", "Weapon", "None", "Slash"),
		basic = true,
		maxRank = 1,
		unlockLevel = 0,
	},
}
for _, skill in basics do
	byId[skill.id] = skill
	table.insert(ids, skill.id)
end
SkillDefinitions.Basics = deepFreeze(basics) :: { Skill }

-- Every skill, in definition order (per job: branch by branch, tier by tier).
SkillDefinitions.All = deepFreeze(skills) :: any
SkillDefinitions.IDS = table.freeze(ids)
local frozenByJob = deepFreeze(byJob) :: { [string]: { Skill } }

function SkillDefinitions.get(id: any): Skill?
	if type(id) ~= "string" then
		return nil
	end
	return byId[id]
end

-- The job's skills in definition order (empty for an unknown job).
function SkillDefinitions.forJob(job: any): { Skill }
	if type(job) ~= "string" then
		return {}
	end
	return frozenByJob[job] or {}
end

-- The skill at `branch` / `tier` of a job's tree.
function SkillDefinitions.at(job: any, branch: string, tier: number): Skill?
	for _, skill in SkillDefinitions.forJob(job) do
		if skill.branch == branch and skill.tier == tier then
			return skill
		end
	end
	return nil
end

-- When the skill's first hit lands after the cast starts (clip Hit frame + delay).
function SkillDefinitions.hitTime(skill: Skill): number
	local clip = if skill.clip then AnimationClips.get(skill.clip) else nil
	local markers = clip and clip.markers
	local hit = if markers and markers.Hit then markers.Hit else 0.1
	return hit + (skill.delay or 0)
end

-- Seconds the caster can't basic-attack after casting (the clip plays out).
function SkillDefinitions.recovery(skill: Skill): number
	local clip = if skill.clip then AnimationClips.get(skill.clip) else nil
	return if clip then math.min(clip.duration, 1.2) else 0.3
end

-- The first effect of `kind`, if any.
function SkillDefinitions.effect(skill: Skill, kind: EffectKind): Effect?
	for _, effect in skill.effects do
		if effect.kind == kind then
			return effect
		end
	end
	return nil
end

-- Effects that hit enemies. A skill is hostile if it has any.
local HOSTILE_KINDS = {
	Damage = true,
	Poison = true,
	Burn = true,
	Stun = true,
	Freeze = true,
	Root = true,
	Slow = true,
	Silence = true,
	Mark = true,
	Weaken = true,
	Taunt = true,
}
SkillDefinitions.HOSTILE_KINDS = table.freeze(HOSTILE_KINDS)

-- Basic skills: every class, always known, no points.
function SkillDefinitions.isBasic(skill: Skill?): boolean
	return skill ~= nil and skill.basic == true
end

-- Hostile skills target enemies, break your spawn protection and tag you
-- for combat; the rest support yourself and your realm.
function SkillDefinitions.isHostile(skill: Skill): boolean
	if skill.target == "Enemy" or skill.target == "EnemyArea" then
		return true
	end
	for _, effect in skill.effects do
		if HOSTILE_KINDS[effect.kind] and not effect.self then
			return true
		end
	end
	return false
end

return table.freeze(SkillDefinitions)
