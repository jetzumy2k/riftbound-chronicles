--!strict
--[[
	SkillDefinitions — every class's skill tree (CLAUDE.md §6-7, Phase 5,
	PLAN.md D-45).

	Each job has a tree of 4 branches x 6 tiers = 24 skills: 20 regular
	(tiers 1-5) and 4 specials, the **ultimates**: the tier-6 capstone of
	each branch, one per branch (creator request 2026-10-26, D-103; tier 3
	was a special before). Players earn skill points by levelling
	(SkillRules.pointsFor) and spend them to learn skills and raise their
	rank; then they choose any 6 learned regular skills + 1 learned
	ultimate for the skill bar.

	Tree fields (derived at load from branch / tier / type)
	  branch / tier   column and row in the tree
	  requires        skill that must be learned first (the tier above)
	  unlockLevel     level needed to learn it: tier 1 at level 0, then
	                  TIER_LEVELS[tier] + one level per branch column, so
	                  something new opens at most levels up to 30
	  maxRank         5 for regular skills, 3 for ultimates; every rank
	                  scales the numbers (SkillRules.effectAtRank) and
	                  higher ranks open with level (SkillRules.rankCap)
	  icon            SkillIcons motif drawn on the skill button

	Skill fields
	  type         "Regular" (6 slots, D-75) or "Special" (the ultimate, 1 slot)
	  category     must be one the job allows (JobDefinitions)
	  target       Enemy | Ally | Self | SelfArea | EnemyArea | Dash
	  range / radius / cooldown / focusCost
	  clip         AnimationClips name played on cast
	  projectileSpeed  studs/s: lands after the Hit frame plus travel
	  delay        extra seconds before an area lands (telegraphed)
	  waves / waveGap  repeated hits (areas or a single target)
	  maxTargets   area skills: targets per wave
	  melee        reach is re-checked at impact
	  effects      in order; `self = true` applies to the caster once
	    Damage    coefficient x Attack (critBonusPct adds crit chance)
	    Heal      coefficient x Attack
	    Shield    absorbs coefficient x Attack for `seconds`
	    Poison / Burn   coefficient x Attack damage every second for `seconds`
	    Regen     coefficient x Attack healing every second for `seconds`
	    Stun      can't move, attack or cast
	    Freeze    like Stun, encased in ice (Shatter combos)
	    Root      can't move        Slow     moves `pct`% slower
	    Silence   can't cast skills
	    Mark      takes `pct`% more damage     Weaken  deals `pct`% less
	    Guard     takes `pct`% less damage     Harden  +`pct`% Defense
	    Empower   +`pct`% Attack               Haste   moves `pct`% faster
	    Taunt     creatures attack the caster (no effect on players)
	    Cleanse   removes Stun, Freeze, Root, Slow, Silence, Mark,
	              Weaken, Poison and Burn
	    Dash      `studs` in `seconds` (the client moves within a
	              server-granted speed allowance); `toward` charges at the
	              target instead of evading backwards (D-103)
	    Reflect   returns `pct`% of each incoming hit to its attacker for
	              `seconds` (capped per hit, scaled in PvP; D-103)
	    Immune    no damage for `seconds` (a damage cut in PvP; D-103)
	    Extend    Extender (D-103): if the caster's own area skill is still
	              active, it pulses `pulses` more times with `pct`% more
	              radius at `coefficient` x its numbers
	  Damage extras (ultimates, D-103): `hpPct` adds that % of the caster's
	  max HP to the hit; `attribute` + `perPointPct` adds % damage per point
	  the caster put into that attribute (AttributeRules).
	  combo        bonus when the target already has `status` (or is below
	               `lowHpPct`% HP): +`bonusPct`% damage, optionally
	               consuming the status. Shown as "COMBO · <name>".
	               `execute`: below the threshold a normal creature falls at
	               once; bosses and players only take the bonus (D-103).
	  fx           visual recipe for CombatVfx / SkillVfx (element palette,
	               cast, travel, impact, area)

	Basic skills (creator request 2026-10-18): every class has them from the
	start, they cost no skill points and have no rank. Auto Attack goes on a
	regular slot like any skill; pressing it targets the nearest creature
	and attacks it with the class's normal attack (CombatController) until
	it falls. It is not a cast: the server never runs it
	(SkillRules.canCast refuses it); the normal attack it drives is checked
	as usual.

	Numbers are first-pass balance (Phase 20 tunes them). The server owns all
	of them; clients only display them. Display-safe data only. Pure module.
]]

local AnimationClips = require(script.Parent.AnimationClips)

export type Target = "Enemy" | "Ally" | "Self" | "SelfArea" | "EnemyArea" | "Dash"

export type EffectKind =
	"Damage"
	| "Heal"
	| "Shield"
	| "Poison"
	| "Burn"
	| "Regen"
	| "Stun"
	| "Freeze"
	| "Root"
	| "Slow"
	| "Silence"
	| "Mark"
	| "Weaken"
	| "Guard"
	| "Harden"
	| "Empower"
	| "Haste"
	| "Taunt"
	| "Cleanse"
	| "Dash"
	| "Reflect"
	| "Immune"
	| "Extend"

export type Effect = {
	kind: EffectKind,
	coefficient: number?,
	critBonusPct: number?,
	seconds: number?,
	pct: number?,
	studs: number?,
	heavy: boolean?,
	self: boolean?,
	-- D-103
	toward: boolean?,
	hpPct: number?,
	attribute: string?,
	perPointPct: number?,
	pulses: number?,
}

export type Combo = {
	status: string?,
	lowHpPct: number?,
	bonusPct: number,
	consume: boolean?,
	execute: boolean?,
	name: string,
}

export type Element =
	"Steel"
	| "Earth"
	| "Holy"
	| "Nature"
	| "Frost"
	| "Fire"
	| "Arcane"
	| "Shadow"
	| "Wind"
	| "Storm"

export type Fx = {
	element: Element,
	cast: "Weapon" | "Hands" | "Raise" | "Circle",
	travel: "None" | "Bolt" | "Orb" | "Arrow" | "Lance" | "Missiles",
	impact: "Slash"
		| "Burst"
		| "Explosion"
		| "Shatter"
		| "Pillar"
		| "Ward"
		| "Heal"
		| "Sigil"
		| "Venom"
		| "Quake",
	area: ("Nova" | "Whirl" | "Quake" | "Rain" | "Meteor" | "Blizzard" | "Circle")?,
}

-- A skill as written below; Skill adds the fields derived at load.
export type SkillSpec = {
	id: string,
	name: string,
	job: string,
	branch: string,
	tier: number,
	type: "Regular" | "Special",
	category: string,
	description: string,
	icon: string,
	target: Target,
	range: number,
	radius: number?,
	cooldown: number,
	focusCost: number,
	clip: string?,
	projectileSpeed: number?,
	delay: number?,
	waves: number?,
	waveGap: number?,
	maxTargets: number?,
	melee: boolean?,
	effects: { Effect },
	combo: Combo?,
	fx: Fx,
	-- Basic skills: every class, always known, no points (Auto Attack).
	basic: boolean?,
}

export type Skill = SkillSpec & {
	requires: string?,
	maxRank: number,
	unlockLevel: number,
}

export type Branch = { id: string, name: string, icon: string, description: string }

