local load = require("../loader")
local Log = load("src/shared/Util/Log")

return function(t)
	local lines: { string } = {}
	local function capture()
		table.clear(lines)
		Log.setSink(function(level, scope, message)
			table.insert(lines, `{level}|{scope}|{message}`)
		end)
	end

	t.it("filters below the minimum level", function()
		capture()
		Log.setLevel("Warn")
		local log = Log.new("T")
		log:Debug("d")
		log:Info("i")
		log:Warn("w")
		log:Error("e")
		t.eq(table.concat(lines, ";"), "Warn|T|w;Error|T|e")
		Log.setLevel("Info")
		Log.setSink(nil)
	end)

	t.it("formats arguments and survives bad format strings", function()
		capture()
		local log = Log.new("T")
		log:Info("n=%d s=%s", 5, "x")
		log:Info("%d", "not a number")
		t.eq(lines[1], "Info|T|n=5 s=x")
		t.ok(string.find(lines[2], "format error", 1, true) ~= nil)
		Log.setSink(nil)
	end)

	t.it("throttles per key and reports suppressed counts", function()
		capture()
		local log = Log.new("T")
		for _ = 1, 5 do
			log:Throttled("sec:1:BadArgs", 1000, "Warn", "rejected")
		end
		log:Throttled("sec:2:BadArgs", 1000, "Warn", "other user")
		t.eq(#lines, 2)
		Log.clearThrottle("sec:1:")
		log:Throttled("sec:1:BadArgs", 1000, "Warn", "again")
		t.eq(#lines, 3)
		t.eq(lines[3], "Warn|T|again")
		Log.clearThrottle("sec:")
		Log.setSink(nil)
	end)

	t.it("clearThrottle prefix does not match other users", function()
		capture()
		local log = Log.new("T")
		log:Throttled("sec:123:X", 1000, "Warn", "a")
		Log.clearThrottle("sec:12:")
		log:Throttled("sec:123:X", 1000, "Warn", "b")
		t.eq(#lines, 1)
		Log.clearThrottle("sec:")
		Log.setSink(nil)
	end)

	t.it("passes the real call site (not the logger) to the sink", function()
		local locations = {}
		Log.setSink(function(_, _, _, location)
			table.insert(locations, location or "nil")
		end)
		local log = Log.new("T")
		log:Info("x")
		log:Throttled("loc:1", 1000, "Warn", "y")
		Log.clearThrottle("loc:")
		Log.setSink(nil)
		for _, location in locations do
			t.ok(string.find(location, "log.spec:", 1, true) ~= nil, location)
		end
		t.eq(#locations, 2)
	end)

	t.it("rejects unknown levels", function()
		t.throws(function()
			Log.setLevel("Verbose" :: any)
		end, "unknown log level")
	end)
end
