local load = require("../loader")
local XPTable = load("src/shared/Logic/XPTable")

return function(t)
	t.it("XPToNext follows round(100 * 1.18^L) (D-18)", function()
		t.eq(XPTable.toNext(0), 100)
		t.eq(XPTable.toNext(1), 118)
		t.eq(XPTable.toNext(2), 139)
		t.eq(XPTable.toNext(10), math.round(100 * 1.18 ^ 10))
		t.eq(XPTable.toNext(29), 12150)
	end)

	t.it("is zero at the level cap", function()
		t.eq(XPTable.toNext(30), 0)
	end)

	t.it("total XP from 0 to 30 is 79,095 (per-level rounding of D-18)", function()
		t.eq(XPTable.totalToReach(30), 79095)
		t.eq(XPTable.totalToReach(0), 0)
		t.eq(XPTable.totalToReach(1), 100)
	end)

	t.it("applies XP within a level", function()
		local r = XPTable.apply(0, 10, 50)
		t.eq(r.level, 0)
		t.eq(r.experience, 60)
		t.eq(r.levelsGained, 0)
		t.eq(r.applied, 50)
		t.eq(r.discarded, 0)
	end)

	t.it("levels up exactly at the threshold", function()
		local r = XPTable.apply(0, 0, 100)
		t.eq(r.level, 1)
		t.eq(r.experience, 0)
		t.eq(r.levelsGained, 1)
	end)

	t.it("handles multi-level gains with overflow carried", function()
		-- 100 + 118 + 139 = 357 reaches level 3; 3 XP left over.
		local r = XPTable.apply(0, 0, 360)
		t.eq(r.level, 3)
		t.eq(r.experience, 3)
		t.eq(r.levelsGained, 3)
		t.eq(r.applied, 360)
	end)

	t.it("never exceeds level 30 and discards excess XP", function()
		local r = XPTable.apply(0, 0, 1000000)
		t.eq(r.level, 30)
		t.eq(r.experience, 0)
		t.eq(r.levelsGained, 30)
		t.eq(r.applied, 79095)
		t.eq(r.discarded, 1000000 - 79095)
	end)

	t.it("grants at the cap are fully discarded", function()
		local r = XPTable.apply(30, 0, 500)
		t.eq(r.level, 30)
		t.eq(r.experience, 0)
		t.eq(r.levelsGained, 0)
		t.eq(r.applied, 0)
		t.eq(r.discarded, 500)
	end)

	t.it("reaching the cap mid-grant discards only the remainder", function()
		local r = XPTable.apply(29, 12000, 200)
		t.eq(r.level, 30)
		t.eq(r.applied, 150)
		t.eq(r.discarded, 50)
	end)

	t.it("rejects invalid levels", function()
		t.throws(function()
			XPTable.toNext(-1)
		end, "invalid level")
		t.throws(function()
			XPTable.totalToReach(31)
		end, "invalid level")
	end)
end
