local load = require("../loader")
local DetailRules = load("src/shared/Logic/DetailRules")

return function(t)
	t.describe("DetailRules", function()
		t.it("classes parts by size", function()
			t.eq(DetailRules.classOf(0.1), 1)
			t.eq(DetailRules.classOf(0.5), 2)
			t.eq(DetailRules.classOf(2), 0)
		end)
		t.it("drops detail with distance and keeps it near", function()
			t.eq(DetailRules.level(10, 0), 0)
			t.eq(DetailRules.level(DetailRules.NEAR + 1, 0), 1)
			t.eq(DetailRules.level(DetailRules.FAR + 1, 0), 2)
			t.eq(DetailRules.level(DetailRules.FAR + 1, 1), 2)
		end)
		t.it("has a margin so a character at a border does not flicker", function()
			local near, far, m = DetailRules.NEAR, DetailRules.FAR, DetailRules.MARGIN
			t.eq(DetailRules.level(near - 1, 1), 1, "stays medium just inside the near border")
			t.eq(DetailRules.level(near - m - 1, 1), 0)
			t.eq(DetailRules.level(far - 1, 2), 2, "stays low just inside the far border")
			t.eq(DetailRules.level(far - m - 1, 2), 1)
			t.eq(DetailRules.level(near - m - 1, 2), 0)
		end)
		t.it("hides only the classes a level drops; effects only at full detail", function()
			t.ok(not DetailRules.hidden(0, 2), "class 0 always shown")
			t.ok(DetailRules.hidden(1, 1))
			t.ok(not DetailRules.hidden(2, 1))
			t.ok(DetailRules.hidden(2, 2))
			t.ok(not DetailRules.hidden(1, 0))
			t.ok(DetailRules.effectsOn(0) and not DetailRules.effectsOn(1))
		end)
	end)
end
